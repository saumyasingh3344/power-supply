<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="100%" height="100%">
  <defs>
    <linearGradient id="liftBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#071B49" />
      <stop offset="50%" stop-color="#0750C8" />
      <stop offset="100%" stop-color="#1464F4" />
    </linearGradient>
    <linearGradient id="doorL" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#FFFFFF" />
      <stop offset="100%" stop-color="#C5DFFF" />
    </linearGradient>
    <linearGradient id="doorR" x1="100%" y1="0%" x2="0%" y2="0%">
      <stop offset="0%" stop-color="#FFFFFF" />
      <stop offset="100%" stop-color="#C5DFFF" />
    </linearGradient>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="12" stdDeviation="16" flood-color="#000000" flood-opacity="0.25"/>
    </filter>
  </defs>

  <!-- Background -->
  <rect width="800" height="500" fill="url(#liftBg)" />
  <circle cx="680" cy="120" r="180" fill="#55B8FF" opacity="0.12" />
  <circle cx="120" cy="400" r="150" fill="#DCEBFF" opacity="0.08" />

  <!-- Subtle Architecture / Shaft Lines -->
  <path d="M0 100 H800 M0 200 H800 M0 300 H800 M0 400 H800" stroke="#FFFFFF" stroke-opacity="0.05" stroke-width="1"/>
  <line x1="220" y1="0" x2="220" y2="500" stroke="#FFFFFF" stroke-opacity="0.12" stroke-width="2" stroke-dasharray="6 6"/>
  <line x1="580" y1="0" x2="580" y2="500" stroke="#FFFFFF" stroke-opacity="0.12" stroke-width="2" stroke-dasharray="6 6"/>

  <!-- Badge Text -->
  <rect x="275" y="30" width="250" height="40" rx="20" fill="#FFFFFF" fill-opacity="0.15" stroke="#FFFFFF" stroke-opacity="0.3" />
  <text x="400" y="55" font-family="Arial, sans-serif" font-size="14" font-weight="bold" fill="#FFFFFF" text-anchor="middle" letter-spacing="2">ELEVATOR &amp; LIFT SERVICE</text>

  <!-- Elevator Enclosure -->
  <g filter="url(#shadow)" transform="translate(250, 95)">
    <!-- Outer Frame -->
    <rect x="0" y="0" width="300" height="360" rx="14" fill="#0A2A75" stroke="#55B8FF" stroke-width="3"/>
    
    <!-- Floor Display Indicator -->
    <rect x="90" y="15" width="120" height="40" rx="8" fill="#071B49" stroke="#1464F4" stroke-width="1.5" />
    <polygon points="115,35 125,23 135,35" fill="#00E676"/>
    <text x="165" y="42" font-family="Arial, sans-serif" font-size="20" font-weight="bold" fill="#55B8FF" text-anchor="middle">L 12</text>

    <!-- Elevator Left Door -->
    <rect x="25" y="70" width="122" height="270" rx="6" fill="url(#doorL)" stroke="#0750C8" stroke-width="2"/>
    <rect x="135" y="180" width="6" height="50" rx="3" fill="#0750C8" />
    <!-- Door panel detailing -->
    <rect x="35" y="90" width="100" height="100" rx="4" fill="none" stroke="#0750C8" stroke-opacity="0.2" stroke-width="2"/>
    <rect x="35" y="210" width="100" height="110" rx="4" fill="none" stroke="#0750C8" stroke-opacity="0.2" stroke-width="2"/>

    <!-- Elevator Right Door -->
    <rect x="153" y="70" width="122" height="270" rx="6" fill="url(#doorR)" stroke="#0750C8" stroke-width="2"/>
    <rect x="159" y="180" width="6" height="50" rx="3" fill="#0750C8" />
    <!-- Door panel detailing -->
    <rect x="165" y="90" width="100" height="100" rx="4" fill="none" stroke="#0750C8" stroke-opacity="0.2" stroke-width="2"/>
    <rect x="165" y="210" width="100" height="110" rx="4" fill="none" stroke="#0750C8" stroke-opacity="0.2" stroke-width="2"/>

    <!-- Center Gap Light -->
    <line x1="150" y1="70" x2="150" y2="340" stroke="#55B8FF" stroke-width="3" stroke-linecap="round"/>
  </g>

  <!-- Left Cable Gear System -->
  <g transform="translate(130, 200)" filter="url(#shadow)">
    <circle cx="0" cy="0" r="48" fill="#FFFFFF" />
    <circle cx="0" cy="0" r="42" fill="#071B49" />
    <!-- Gear teeth -->
    <path d="M-6 -42 H6 V-34 H-6 Z M-6 34 H6 V42 H-6 Z M-42 -6 V6 H-34 V-6 Z M34 -6 V6 H42 V-6 Z" fill="#55B8FF"/>
    <circle cx="0" cy="0" r="24" fill="none" stroke="#55B8FF" stroke-width="4"/>
    <circle cx="0" cy="0" r="10" fill="#FFFFFF"/>
    <!-- Pulley Cable -->
    <line x1="-30" y1="-80" x2="-30" y2="120" stroke="#DCEBFF" stroke-width="4" stroke-dasharray="8 4"/>
  </g>

  <!-- Right Inspection / Safety Checkmark Badge -->
  <g transform="translate(660, 280)" filter="url(#shadow)">
    <circle cx="0" cy="0" r="46" fill="#FFFFFF" />
    <circle cx="0" cy="0" r="40" fill="#1464F4" />
    <!-- Shield / Checkmark -->
    <path d="M-15 -3 L-5 7 L15 -13" fill="none" stroke="#FFFFFF" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
  </g>
</svg>
